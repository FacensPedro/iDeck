-void syscall_dispatcher_return_slowpath(void)
-{
-    raise( SIGUSR2 );
-}
+void syscall_dispatcher_return_slowpath(void)
+{
+#ifdef WINE_IOS
+    /* Guest CONTEXT_INTEGER needs both x16 and x17 restored. SIGUSR2 via
+     * Apple's raise/pthread_kill is intercepted as a Mach breakpoint under
+     * StikDebug; it cannot faithfully restore FEX's live x17 and x18.
+     * The registered Wine Mach handler recognises this exact BRK and
+     * resumes the suspended thread from the full ntdll syscall frame. */
+    __asm__ volatile( "brk #0x5a5a" ::: "memory" );
+    __builtin_unreachable();
+#else
+    raise( SIGUSR2 );
+#endif
+}
 
