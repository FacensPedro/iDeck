+        unsigned n = __sync_add_and_fetch( &restored, 1 );
+        if (n <= 8 || !(n % 1000))
+            dprintf( 2, "[arm64ec-context] restored #%u pc=%p sp=%p "
+                        "x16=%p x17=%p x18=TEB (Mach, no SIGUSR2)\n",
+                     n, (void *)(uintptr_t)frame.pc,
+                     (void *)(uintptr_t)frame.sp,
+                     (void *)(uintptr_t)frame.x[16],
+                     (void *)(uintptr_t)frame.x[17] );
+    }
+    return 1;
+}
