     static int ios_page0_attempted = 0;
-    if (ios_page0_attempted) {
+    /* iDeck: XNU never lets a process map address 0, and on device all eight
+     * approaches failed every run (M8's StikDebug BRK came back as a stray trap).
+     * They only cost start-up time, so they run only with MADEIRA_PAGE0_PROBE=1;
+     * otherwise the Mach handler covers x18=0 straight away. */
+    const char *ios_page0_probe = getenv( "MADEIRA_PAGE0_PROBE" );
+    if (!ios_page0_attempted && (!ios_page0_probe || strcmp( ios_page0_probe, "1" ))) {
+        ios_page0_attempted = 1;
+        ERR("page0: mapping attempts skipped (iOS refuses address 0) — Mach handler covers x18=0\n");
+    } else if (ios_page0_attempted) {
         ERR("page0: already attempted by first thread — skipping (Mach handler covers x18=0)\n");
     } else {
         ios_page0_attempted = 1;
