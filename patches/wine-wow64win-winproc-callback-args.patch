+     * memory does survive (ret_ptr and ret_len are right), so keep the pointer there
+     * and read it back after the call. */
+    saved_arg = arg;
     status = Wow64KiUserCallbackDispatcher( NtUserCallWinProc, params32,
                                             offset32 + lparam_size,
                                             &ret_ptr, &ret_len );
+    params32 = saved_arg;
 
-    if (ret_len >= sizeof(LONG))
+    if (!status && ret_ptr && ret_len >= sizeof(LONG))
     {
-        LRESULT *result_ptr = arg;
+        LRESULT *result_ptr = saved_arg;
         result = *(LONG *)ret_ptr;
         ret_len = packed_result_32to64( params32->msg, params32->wparam, (LONG *)ret_ptr + 1,
                                         ret_len - sizeof(LONG), result_ptr + 1 );
