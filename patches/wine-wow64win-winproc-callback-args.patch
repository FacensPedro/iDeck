diff --git a/dlls/wow64win/user.c b/dlls/wow64win/user.c
index f9d19b0249..a4d708a82b 100644
--- a/dlls/wow64win/user.c
+++ b/dlls/wow64win/user.c
@@ -954,6 +954,7 @@ static NTSTATUS WINAPI wow64_NtUserCallWinProc( void *arg, ULONG size )
 {
     struct win_proc_params *params = arg;
     struct win_proc_params32 *params32 = arg;
+    void * volatile saved_arg;
     size_t lparam_size = 0, offset32 = sizeof(*params32);
     LRESULT result = 0;
     void *ret_ptr;
@@ -971,13 +972,21 @@ static NTSTATUS WINAPI wow64_NtUserCallWinProc( void *arg, ULONG size )
                                              size - offset64 );
     }
 
+    /* iDeck: the callback comes back through a longjmp from FEX's guest frames, and
+     * on iOS the registers the compiler kept arg in did not always survive it
+     * (Assassin's Creed IV, WM_GETMINMAXINFO in its first CreateWindowEx: params32
