diff --git a/src/dxmt/dxmt_pipeline_archive.cpp b/src/dxmt/dxmt_pipeline_archive.cpp
new file mode 100644
index 0000000..ab9c1ab
--- /dev/null
+++ b/src/dxmt/dxmt_pipeline_archive.cpp
@@ -0,0 +1,64 @@
+#include "dxmt_pipeline_archive.hpp"
+#include "dxmt_shader_cache.hpp"
+#include "util_env.hpp"
+#include "util_string.hpp"
+#include "log/log.hpp"
+#include <memory>
+
+namespace dxmt {
+
+PipelineArchive &
+PipelineArchive::get(WMT::Device device, WMTMetalVersion version) {
+  /* Same two-slot pattern as ShaderCache::getInstance (ml724). */
+  static dxmt::mutex mutex;
+  static std::unique_ptr<PipelineArchive> archive_310;
+  static std::unique_ptr<PipelineArchive> archive_320;
+
+  std::lock_guard<dxmt::mutex> lock(mutex);
+  std::unique_ptr<PipelineArchive> &slot = (version == WMTMetal310) ? archive_310 : archive_320;
+  if (!slot)
+    slot = std::make_unique<PipelineArchive>(device, version);
+  return *slot;
+}
+
+PipelineArchive::PipelineArchive(WMT::Device device, WMTMetalVersion version) {
+  if (env::getEnvVar("DXMT_PIPELINE_ARCHIVE") != "1" || env::getEnvVar("DXMT_SHADER_CACHE") == "0")
+    return;
+  /* Relative paths are resolved to the shader cache directory by winemetal's
+   * unix side, exactly like shaders_*.db. The cache format version is part of
+   * the name, so a format change starts a new archive. */
+  path_ = GetDXMTShaderCacheDirectory() +
+          str::format("pipelines_", (unsigned int)version, "_v", kDXMTShaderCacheVersion, ".metalar");
+  WMT::Error err;
+  archive_ = device.newBinaryArchive(path_.c_str(), err);
+  if (!archive_ || err) {
+    WARN("PipelineArchive: cannot open ", path_, " -- starting an empty archive");
+    WMT::Error err2;
+    archive_ = device.newBinaryArchive(nullptr, err2);
+    if (!archive_ || err2) {
+      archive_ = WMT::Reference<WMT::BinaryArchive>();
+      ERR("PipelineArchive: Metal refused an empty archive; pipeline archive off");
+      return;
+    }
+  }
+  handle_ = archive_.handle;
+  WARN("PipelineArchive: on (", path_, ")");
+}
+
+void
+PipelineArchive::noteCreated() {
+  if (!archive_)
+    return;
+  if (since_serialize_.fetch_add(1, std::memory_order_relaxed) + 1 < kSerializeEvery)
+    return;
+  std::unique_lock<dxmt::mutex> lock(serialize_mutex_, std::try_to_lock);
+  if (!lock.owns_lock())
+    return;
+  since_serialize_.store(0, std::memory_order_relaxed);
+  WMT::Error err;
+  archive_.serialize(path_.c_str(), err);
+  if (err)
+    WARN("PipelineArchive: serialize failed: ", err.description().getUTF8String());
+}
+
+} // namespace dxmt
diff --git a/src/dxmt/dxmt_pipeline_archive.hpp b/src/dxmt/dxmt_pipeline_archive.hpp
new file mode 100644
index 0000000..38e6ff6
--- /dev/null
+++ b/src/dxmt/dxmt_pipeline_archive.hpp
@@ -0,0 +1,53 @@
+#pragma once
+
+#include "Metal.hpp"
+#include "thread.hpp"
+#include <atomic>
+#include <string>
+
+namespace dxmt {
+
+/* iDeck: a Metal binary archive of compiled pipeline states, so the AIR->GPU
+ * compile of a pipeline seen in an earlier session is skipped (the DXBC->AIR
+ * step is already cached in shaders_*.db). Opt-in: DXMT_PIPELINE_ARCHIVE=1.
+ *
+ * Costs on a miss: winemetal adds the pipeline to the archive right after
+ * creating it, which compiles it a second time -- so a first session with the
+ * archive on stutters MORE, and only later sessions gain. The archive is
+ * written every kSerializeEvery additions (and is lost if the app is killed
+ * before that). A file Metal cannot open is deleted and started over. */
+class PipelineArchive {
+public:
+  static PipelineArchive &get(WMT::Device device, WMTMetalVersion version);
+
+  /* Fill the lookup / serialization fields of a pipeline descriptor. */
+  template <typename Info>
+  void
+  attach(Info &info) {
+    if (!archive_)
+      return;
+    info.binary_archives_for_lookup.set(&handle_);
+    info.num_binary_archives_for_lookup = 1;
+    info.binary_archive_for_serialization = handle_;
+    info.fail_on_binary_archive_miss = false;
+  }
+
+  /* After a successful pipeline creation with attach(). */
+  void noteCreated();
+
+  bool enabled() const { return archive_ != nullptr; }
+
+  PipelineArchive(WMT::Device device, WMTMetalVersion version);
+  PipelineArchive(const PipelineArchive &) = delete;
+
+private:
+  static constexpr uint32_t kSerializeEvery = 32;
+
+  WMT::Reference<WMT::BinaryArchive> archive_;
+  obj_handle_t handle_ = 0;
+  std::string path_;
+  std::atomic<uint32_t> since_serialize_{0};
+  dxmt::mutex serialize_mutex_;
+};
+
+} // namespace dxmt
