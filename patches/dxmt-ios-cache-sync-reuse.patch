+/* iDeck: frames the CPU may run ahead of the GPU when the game does not choose
+ * (or passes 0 to SetMaximumFrameLatency). 2 on iOS: each frame in flight keeps
+ * its staging memory alive and adds input latency. DXMT_MAX_FRAME_LATENCY=1..16
+ * overrides it. */
+inline uint32_t
+defaultMaxFrameLatency() {
+  static const uint32_t value = [] {
+    const std::string v = getEnvVar("DXMT_MAX_FRAME_LATENCY");
+    long n = v.empty() ? 2 : std::strtol(v.c_str(), nullptr, 10);
+    return (uint32_t)(n >= 1 && n <= 16 ? n : 2);
+  }();
+  return value;
+}
+
+/* iDeck: the app publishes iOS memory pressure (0 normal, 1 warning,
+ * 2 critical) in a word of its own memory and passes its address in
+ * IDECK_MEMORY_PRESSURE_ADDR. A 64-bit (ARM64EC) DXMT shares that address
+ * space and can read it directly; a 32-bit build cannot reach it and always
+ * sees 0. */
+inline uint32_t
+iosMemoryPressure() {
+  static const volatile uint32_t *word = []() -> const volatile uint32_t * {
+    if (sizeof(void *) < 8)
+      return nullptr;
+    const std::string v = getEnvVar("IDECK_MEMORY_PRESSURE_ADDR");
+    unsigned long long a = v.empty() ? 0 : std::strtoull(v.c_str(), nullptr, 16);
+    return a ? (const volatile uint32_t *)(uintptr_t)a : nullptr;
+  }();
+  return word ? *word : 0;
+}
+
 } // namespace dxmt::env
