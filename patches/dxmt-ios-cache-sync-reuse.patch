diff --git a/src/winemetal/unix/cache_trim.h b/src/winemetal/unix/cache_trim.h
new file mode 100644
index 0000000..26eca56
--- /dev/null
+++ b/src/winemetal/unix/cache_trim.h
@@ -0,0 +1,53 @@
+#pragma once
+#include <sqlite3.h>
+#include <stdint.h>
+#include <string.h>
+
+static sqlite3_int64 wmt_cache_scalar(sqlite3 *db, const char *sql) {
+  sqlite3_stmt *stmt = NULL;
+  sqlite3_int64 value = -1;
+  if (sqlite3_prepare_v2(db, sql, -1, &stmt, NULL) == SQLITE_OK && sqlite3_step(stmt) == SQLITE_ROW)
+    value = sqlite3_column_int64(stmt, 0);
+  sqlite3_finalize(stmt);
+  return value;
+}
+
+/* All cleanup goes through SQLite's WAL/transaction locks. Existing readers
+ * retain their snapshots; never unlink a database, WAL or SHM under them. */
+static int wmt_trim_shader_cache(sqlite3 *db, sqlite3_int64 limit) {
+  if (limit <= 0) return SQLITE_OK;
+  sqlite3_int64 pages = wmt_cache_scalar(db, "PRAGMA page_count");
+  sqlite3_int64 free_pages = wmt_cache_scalar(db, "PRAGMA freelist_count");
+  sqlite3_int64 page_size = wmt_cache_scalar(db, "PRAGMA page_size");
+  if (pages < 0 || free_pages < 0 || free_pages > pages || page_size <= 0) return SQLITE_ERROR;
+  if (pages - free_pages <= limit / page_size) return SQLITE_OK;
+  int rc = sqlite3_exec(db, "BEGIN IMMEDIATE", NULL, NULL, NULL);
+  if (rc != SQLITE_OK) return rc; /* busy: leave the live cache intact */
+  sqlite3_stmt *tables = NULL;
+  rc = sqlite3_prepare_v2(db, "SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'cache_%'", -1, &tables, NULL);
+  if (rc == SQLITE_OK) {
+    int step;
+    while ((step = sqlite3_step(tables)) == SQLITE_ROW) {
+      const char *name = (const char *)sqlite3_column_text(tables, 0);
+      if (!name || strncmp(name, "cache_", 6) != 0 || !name[6]) continue;
+      const char *digit = name + 6;
+      while (*digit >= '0' && *digit <= '9') ++digit;
+      if (*digit) continue;
+      char *sql = sqlite3_mprintf("DELETE FROM \"%w\"", name);
+      rc = sql ? sqlite3_exec(db, sql, NULL, NULL, NULL) : SQLITE_NOMEM;
+      sqlite3_free(sql);
+      if (rc != SQLITE_OK) break;
+    }
+    if (rc == SQLITE_OK && step != SQLITE_DONE) rc = step;
+  }
+  sqlite3_finalize(tables);
+  if (rc == SQLITE_OK) rc = sqlite3_exec(db, "COMMIT", NULL, NULL, NULL);
+  if (rc != SQLITE_OK) {
+    sqlite3_exec(db, "ROLLBACK", NULL, NULL, NULL);
+    return rc;
+  }
+  // Compaction is best effort: SQLITE_BUSY is safe when a reader is active.
+  sqlite3_exec(db, "VACUUM", NULL, NULL, NULL);
+  sqlite3_wal_checkpoint_v2(db, NULL, SQLITE_CHECKPOINT_PASSIVE, NULL, NULL);
+  return SQLITE_OK;
+}
