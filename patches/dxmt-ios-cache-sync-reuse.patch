+  /* iDeck: wait until \c value is signaled or \c timeout_ns passes, parked in
+   * the kernel (RtlWaitOnAddress) rather than yielding in a loop. Returns
+   * whether the value was reached. */
+  template <typename Clock>
+  bool wait_until(uint64_t value, typename Clock::time_point deadline) {
+    for (;;) {
+      uint64_t current = value_.load(std::memory_order_acquire);
+      if (current >= value)
+        return true;
+      auto now = Clock::now();
+      if (now >= deadline)
+        return false;
+      uint64_t left = (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(deadline - now).count();
+      if (futex::backend() == WaitBackend::AddressWait)
+        futex::address_wait_for(&value_, &current, sizeof(current), left);
+      else
+        std::this_thread::yield();
+    }
+  }
+
   uint64_t signaledValue() {
     return value_.load(std::memory_order_acquire);
   }
