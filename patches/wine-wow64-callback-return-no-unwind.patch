diff --git a/dlls/ntdll/signal_arm64ec.c b/dlls/ntdll/signal_arm64ec.c
index f82eb68..dd558f5 100644
--- a/dlls/ntdll/signal_arm64ec.c
+++ b/dlls/ntdll/signal_arm64ec.c
@@ -5066,6 +5066,21 @@ void __cdecl NTDLL_longjmp( _JUMP_BUFFER *buf, int retval )
     rec.ExceptionAddress = NULL;
     rec.NumberParameters = 1;
     rec.ExceptionInformation[0] = (DWORD_PTR)buf;
+
+    /* iDeck: no frame means no unwind, as in the x64 CRT: the saved registers are
+     * restored directly.  wow64's user-callback return clears Frame (wow64/syscall.c),
+     * because the frames between it and the callback's setjmp are FEX's translated
+     * guest code, which has no unwind data: RtlUnwind looped there until the stack
+     * overflowed (c0000026, then c00000fd; BioShock 2 creating its first window). */
+    if (!buf->Frame)
+    {
+        CONTEXT context;
+
+        RtlCaptureContext( &context );
+        context.Rax = retval;   /* x64 target */
+        context.Rcx = retval;   /* ARM64EC target (x0) */
+        RtlRestoreContext( &context, &rec );   /* takes Rip, Rsp and the saved registers from buf */
+    }
     RtlUnwind( (void *)buf->Frame, (void *)buf->Rip, &rec, IntToPtr(retval) );
 }
 
diff --git a/dlls/wow64/syscall.c b/dlls/wow64/syscall.c
index 2fd5918..e1e29ae 100644
--- a/dlls/wow64/syscall.c
+++ b/dlls/wow64/syscall.c
@@ -610,6 +610,12 @@ NTSTATUS WINAPI wow64_NtCallbackReturn( UINT *args )
     *frame->ret_ptr = ret_ptr;
     *frame->ret_len = ret_len;
     frame->status = status;
+#ifdef __arm64ec__
+    /* iDeck: return to the callback's setjmp without unwinding (see NTDLL_longjmp).
+     * Between here and there are only FEX's translated guest frames, which have no
+     * unwind data and nothing to clean up on the host side. */
+    ((_JUMP_BUFFER *)frame->jmpbuf)->Frame = 0;
+#endif
     longjmp( frame->jmpbuf, 1 );
     return STATUS_SUCCESS;
 }
