+#ifdef __arm64ec__
+/* iDeck: a PURE ARM64 module (wow64.dll, xtajit.dll in a WoW64 child of an
+ * ARM64EC session) calls what it resolves with BLR, natively: it can never run
+ * an ARM64EC module's .hexpthk x86_64 export thunk. */
+static BOOL is_native_arm64_module( HMODULE module )
+{
+    const IMAGE_NT_HEADERS *nt = module ? RtlImageNtHeader( module ) : NULL;
+    return nt && nt->FileHeader.Machine == IMAGE_FILE_MACHINE_ARM64 &&
+           !arm64ec_get_module_metadata( module );
+}
+extern void *xlate_ios_jit_rev( void *ptr );
+#endif
+
