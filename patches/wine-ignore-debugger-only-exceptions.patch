diff --git a/dlls/ntdll/unix/thread.c b/dlls/ntdll/unix/thread.c
index 1958807..b54ec79 100644
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -1615,6 +1615,23 @@ NTSTATUS WINAPI NtRaiseException( EXCEPTION_RECORD *rec, CONTEXT *context, BOOL
 
     if (first_chance) return call_user_exception_dispatcher( rec, context );
 
+    /* iDeck: exceptions raised only to talk to a debugger -- thread names
+     * (0x406D1388, SetThreadName) and debug output (DBG_PRINTEXCEPTION_C,
+     * DBG_PRINTEXCEPTION_WIDE_C) -- are caught by the program's own __except on
+     * Windows.  In an iOS WoW64 process that 32-bit handler is not reached, and
+     * the unhandled raise ended the game (Assassin's Creed IV, abort_process
+     * status=0x406d1388).  With no debugger they mean nothing: the raise returns
+     * to its caller, as the caught exception would have. */
+    if (rec->ExceptionCode == 0x406d1388 || rec->ExceptionCode == DBG_PRINTEXCEPTION_C ||
+        rec->ExceptionCode == DBG_PRINTEXCEPTION_WIDE_C)
+    {
+        static int ignored;
+        if (ignored++ < 8)
+            ERR_(seh)("ignoring unhandled debugger-only exception %x addr %p\n",
+                      rec->ExceptionCode, rec->ExceptionAddress );
+        return STATUS_SUCCESS;
+    }
+
     if (rec->ExceptionFlags & EXCEPTION_STACK_INVALID)
         ERR_(seh)("Exception frame is not in stack limits => unable to dispatch exception.\n");
     else if (rec->ExceptionCode == STATUS_NONCONTINUABLE_EXCEPTION)
