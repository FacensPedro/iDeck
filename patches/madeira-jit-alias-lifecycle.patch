diff --git a/build/ntdll-unix/virtual_ios.c b/build/ntdll-unix/virtual_ios.c
index def1962..7e23bd2 100644
--- a/build/ntdll-unix/virtual_ios.c
+++ b/build/ntdll-unix/virtual_ios.c
@@ -14369,6 +14369,42 @@ static void ios_vh_dump( const void *addr )
  *
  * Deletes a view. virtual_mutex must be held by caller.
  */
+/***********************************************************************
+ *           ios_jit_purge_image_aliases
+ *
+ * iDeck: an unloaded DLL takes its anon-JIT aliases with it.  The ml632
+ * classifier can register an anonymous RWX alias over the tail of an image
+ * (Borderlands 2: shcore, sechost, imm32, libmono, msacm32, dnsapi, each a
+ * 16KB host page shared with the image's last 4KB pages).  Without this the
+ * alias outlived the image: the next DLL mapped at that address had its pages
+ * claimed by a stale alias that iat-sync and the store emulator both honour.
+ * Same tombstone order as ios_jit_purge_window.
+ */
+static void ios_jit_purge_image_aliases( void *base, size_t size )
+{
+    uintptr_t lo = (uintptr_t)base, hi = lo + size;
+    int i, purged = 0;
+
+    if (!size) return;
+    pthread_mutex_lock( &ios_pool_lock );
+    for (i = 0; i < ios_jit_anon_alias_count; i++)
+    {
+        uintptr_t uv = ios_jit_anon_aliases[i].user_va;
+
+        if (!uv || uv >= hi || ios_jit_anon_aliases[i].user_va_end <= lo) continue;
+        if (purged < 8)
+            dprintf( 2, "[mixed-map] anon RWX alias %p..%p retired with its image %p+0x%lx\n",
+                     (void *)uv, (void *)ios_jit_anon_aliases[i].user_va_end, base,
+                     (unsigned long)size );
+        ios_jit_anon_aliases[i].user_va_end = 0;
+        __sync_synchronize();
+        ios_mono_alias_retire( uv );
+        ios_jit_anon_aliases[i].user_va = 0;
+        purged++;
+    }
+    pthread_mutex_unlock( &ios_pool_lock );
+}
+
