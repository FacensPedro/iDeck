 /* Pipelines are created from several threads at once, so a single slot would
  * be stolen between one caller's too-small call and its retry. Eight is far
  * more than the number of threads that are ever between those two calls. */
+/* Only overlapping requests for the same complete DXIL cache key wait.
+ * Each owner lives on its calling thread's stack until publication or error. */
+class DXILConversion {
+    static pthread_mutex_t mutex;
+    static pthread_cond_t changed;
+    static DXILConversion *active;
+    DXILConversion *next = nullptr;
+    uint64_t key = 0, check = 0;
+    bool registered = false;
+
+    bool alreadyActive() const {
+        for (auto *p = active; p; p = p->next)
+            if (p->key == key && p->check == check) return true;
+        return false;
+    }
+
+public:
+    DXILConversion() = default;
+    DXILConversion(const DXILConversion &) = delete;
+    void acquire(uint64_t k, uint64_t c) {
+        key = k;
+        check = c;
+        pthread_mutex_lock(&mutex);
+        while (alreadyActive()) pthread_cond_wait(&changed, &mutex);
+        next = active;
+        active = this;
+        registered = true;
+        pthread_mutex_unlock(&mutex);
+    }
+    ~DXILConversion() {
+        if (!registered) return;
+        pthread_mutex_lock(&mutex);
+        auto **link = &active;
+        while (*link != this) link = &(*link)->next;
+        *link = next;
+        pthread_cond_broadcast(&changed);
+        pthread_mutex_unlock(&mutex);
+    }
+};
+
+pthread_mutex_t DXILConversion::mutex = PTHREAD_MUTEX_INITIALIZER;
+pthread_cond_t DXILConversion::changed = PTHREAD_COND_INITIALIZER;
+DXILConversion *DXILConversion::active = nullptr;
