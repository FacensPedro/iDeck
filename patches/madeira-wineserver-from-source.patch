@@ -114,6 +104,33 @@
     "storage_device_ios:storage_device_ios.c:storage_device_ios.o"
 )
 
+# A clean checkout has no base archive. Compile every unmodified server
+# source with the same iOS flags; PATCHED_FILES supplies the replacements.
+if [[ "${1:-all}" == "all" ]]; then
+    BASE_OBJECTS=()
+    SERVER_SOURCES="$(sed -n 's/^[[:space:]]*\([[:alnum:]_]*\)\.c[[:space:]\\]*$/\1/p' "$WINE_SRC/server/Makefile.in")"
+    [[ -n "$SERVER_SOURCES" ]] || { echo "ERROR: no Wine server sources found" >&2; exit 1; }
+    for name in $SERVER_SOURCES; do
+        patched=0
+        for entry in "${PATCHED_FILES[@]}"; do
+            if [[ "${entry##*:}" == "$name.o" ]]; then
+                patched=1
+                break
+            fi
+        done
+        if [[ "$patched" == "0" ]]; then
+            compile_one "$WINE_SRC/server/$name.c" "$name"
+            BASE_OBJECTS+=("$OBJ_DIR/$name.o")
+        fi
+    done
+    [[ "${#BASE_OBJECTS[@]}" -gt 0 ]] || { echo "ERROR: no base server objects built" >&2; exit 1; }
+    rm -f "$OBJ_DIR/libwineserver.a"
+    xcrun --sdk iphoneos ar rcs "$OBJ_DIR/libwineserver.a" "${BASE_OBJECTS[@]}"
+elif [[ ! -s "$OBJ_DIR/libwineserver.a" ]]; then
+    echo "ERROR: run a full wineserver build before a partial rebuild" >&2
+    exit 1
+fi
+
 echo "=== Building kill wrapper (without kill macro) ==="
 echo -n "  wineserver_ios_kill... "
 # Compile WITHOUT -include wineserver_ios_kill.h to avoid recursive macro
