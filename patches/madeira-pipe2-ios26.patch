diff --git a/build/ntdll-unix/server_ios.c b/build/ntdll-unix/server_ios.c
index c1a2038..4a636a8 100644
--- a/build/ntdll-unix/server_ios.c
+++ b/build/ntdll-unix/server_ios.c
@@ -4674,6 +4674,17 @@ int server_pipe( int fd[2] )
     int ret;
 #ifdef HAVE_PIPE2
     static BOOL have_pipe2 = TRUE;
+#ifdef WINE_IOS
+    /* iDeck: Wine is configured against an SDK that has pipe2 (iOS 27). On iOS 26
+     * the weak import resolves to NULL and the call jumped to address 0 right after
+     * the first wineserver connection (iPhone 15, iOS 26.5: pc=0 esr=0x82000006). */
+    static BOOL pipe2_checked;
+    if (!pipe2_checked)
+    {
+        have_pipe2 = dlsym( RTLD_DEFAULT, "pipe2" ) != NULL;
+        pipe2_checked = TRUE;
+    }
+#endif
 
     if (have_pipe2)
     {
