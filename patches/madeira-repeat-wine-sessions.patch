diff --git a/app/Madeira/WineProcessBridge.m b/app/Madeira/WineProcessBridge.m
--- a/app/Madeira/WineProcessBridge.m
+++ b/app/Madeira/WineProcessBridge.m
@@ -342,6 +342,10 @@
 volatile int g_madeira_srv_fgetpath = 0;
 static pthread_t g_wine_thread;
 static volatile int g_wine_running = 0;
+/* The old g_wine_running drops before wineserver_stop() and thread cleanup.
+ * Only this release/acquire flag permits another guest in the same app run. */
+static int g_wine_thread_finished = 1;
+int wine_process_thread_finished(void) { return __atomic_load_n(&g_wine_thread_finished, __ATOMIC_ACQUIRE); }
 /* madeira-bcd: the server's per-launch switches (fd_ios.c, request_ios.c; ntdll's
@@ -2077,6 +2081,7 @@
             *(void **)(tsd_base + 275 * 8) = NULL;
         }
     }
+    __atomic_store_n(&g_wine_thread_finished, 1, __ATOMIC_RELEASE);
     return NULL;
 }
@@ -2084,6 +2089,10 @@
     if (g_wine_running) {
         LOG("Wine process already running");
         return 0;
     }
+    if (!wine_process_thread_finished()) {
+        LOG("Previous Wine worker is still cleaning up");
+        return -1;
+    }
 
     if (g_prefix_path) free(g_prefix_path);
@@ -2091,7 +2100,8 @@
     LOG("Starting Wine process with prefix: %{public}s", prefix_path);
 
     g_wine_running = 1;
+    __atomic_store_n(&g_wine_thread_finished, 0, __ATOMIC_RELEASE);
 
     // Create socketpair to bypass broken iOS UDS accept()
@@ -2100,6 +2110,7 @@
     if (socketpair(AF_UNIX, SOCK_STREAM, 0, pair) == -1) {
         LOG("socketpair failed: %{public}s", strerror(errno));
         g_wine_running = 0;
+        __atomic_store_n(&g_wine_thread_finished, 1, __ATOMIC_RELEASE);
         return -1;
     }
@@ -2130,6 +2141,7 @@
         close(pair[0]);
         close(pair[1]);
         g_wine_running = 0;
+        __atomic_store_n(&g_wine_thread_finished, 1, __ATOMIC_RELEASE);
         return -1;
     }
diff --git a/app/Madeira/WineServerBridge.m b/app/Madeira/WineServerBridge.m
--- a/app/Madeira/WineServerBridge.m
+++ b/app/Madeira/WineServerBridge.m
@@ -154,6 +154,9 @@
     {
         extern int wineserver_ready;
         __atomic_store_n(&wineserver_ready, 0, __ATOMIC_RELEASE);
     }
+    /* wineserver_stop() leaves this flag set; a second game would otherwise
+     * immediately exit the server event loop on the same app run. */
+    __atomic_store_n(&g_wineserver_should_stop, 0, __ATOMIC_RELEASE);
     g_wineserver_running = 1;
