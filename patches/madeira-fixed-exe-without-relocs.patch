+    {
+        mapping->image.image_charact |= IMAGE_FILE_RELOCS_STRIPPED;
+        fprintf( stderr, "[fixed-exe] image base %#llx: DYNAMIC_BASE without relocations -- kept at its "
+                 "preferred base\n", (unsigned long long)mapping->image.base );
+    }
+
     if (mapping->image.alignment & page_mask)
         mapping->image.image_flags |= IMAGE_FLAGS_ImageMappedFlat;
     else if ((mapping->image.dll_charact & IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE) &&
-             (has_relocs || mapping->image.contains_code) && !(clr_va && clr_size))
+             (has_relocs || (mapping->image.contains_code && (nt.FileHeader.Characteristics & IMAGE_FILE_DLL))) &&
