+    /* iDeck: a program (not a DLL) that asks for ASLR but has no relocations to
+     * apply can only run at its preferred base -- Windows loads it there. Dark
+     * Souls Remastered's exe has no .reloc section and sets DYNAMIC_BASE: moved to
+     * an ASLR address it failed with "failed to create main module ... c0000018",
+     * and as a small image it never got the 0x140000000 window. Report it as
+     * RELOCS_STRIPPED and not dynamically relocated, so it maps at its base and
+     * the window's fixed-base rule (MADEIRA_EXE_WINDOW_SMALL_FIXED) applies. */
+    if (!has_relocs && !(nt.FileHeader.Characteristics & IMAGE_FILE_DLL) &&
