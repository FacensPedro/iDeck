 #endif
+    /* iDeck 2.16.2: the thread-name exception is never dispatched. In an iOS WoW64
+     * process (Assassin's Creed IV's UPC_Net thread, Fallout: New Vegas) the
+     * context of this raise carries pc=0, so neither the program's __except nor
+     * NtContinue at second chance can resume it: continuing jumped to address 0
+     * and the process was torn down ("[fault-stuck] ... abort_process"). With no
+     * debugger the raise names a thread and nothing else, so return at once and
+     * RaiseException returns to its caller as on Windows after the handler. */
+    if (rec && rec->ExceptionCode == 0x406d1388 && first_chance)
+    {
+        static int skipped;
+        if (skipped++ < 8)
+            ERR_(seh)("[thread-name] 0x406d1388 at %p not dispatched -- returning to the caller\n",
+                      rec->ExceptionAddress );
+        return STATUS_SUCCESS;
+    }
     status = send_debug_event( rec, context, first_chance, !(is_win64 || is_wow64() || is_old_wow64()) );
 
     if (status == DBG_CONTINUE || status == DBG_EXCEPTION_HANDLED)
@@ -2362,6 +2377,21 @@ NTSTATUS WINAPI NtRaiseException( EXCEPTION_RECORD *rec, CONTEXT *context, BOOL
         return NtContinue( context, FALSE );
     }
 
+    /* iDeck: the thread-name exception (0x406D1388, SetThreadName) is, like a debug
+     * print, raised only for a debugger and caught by the program's own __except.
+     * In an iOS WoW64 process that 32-bit handler is not reached ("[exc-disp]
+     * dispatch ... pc=0"), and the unhandled raise ended Assassin's Creed IV
+     * (abort_process status=0x406d1388). With no debugger it means nothing:
+     * continue, as for DBG_PRINTEXCEPTION_C above. */
+    if (rec->ExceptionCode == 0x406d1388)
+    {
+        static int names;
+        if (names++ < 8)
+            ERR_(seh)("[thread-name] swallowing 0x406d1388 that reached second chance "
+                      "(addr=%p) -- continuing instead of dying\n", rec->ExceptionAddress );
+        return NtContinue( context, FALSE );
+    }
+
     if (rec->ExceptionFlags & EXCEPTION_STACK_INVALID)
         ERR_(seh)("Exception frame is not in stack limits => unable to dispatch exception.\n");
     else if (rec->ExceptionCode == STATUS_NONCONTINUABLE_EXCEPTION)
