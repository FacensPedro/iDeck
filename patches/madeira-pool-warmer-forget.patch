+/* iDeck: the app frees the JIT pool when its Windows session ends (MadeiraWinePool
+ * release) while this process keeps running. The warmer kept the old addresses and
+ * read the unmapped RW alias at the next cycle: SEGV at 0x7000000000 in
+ * ios_pool_warmer_thread, right after "[jit-pool] ... pool released". The app now
+ * calls ideck_wine_jit_pool_forget() before it unmaps the pool: the warmer stops
+ * touching it (waiting out a pass already running) until a new pool is exported. */
+static volatile int ios_pool_gone;
+static volatile int ios_pool_warmer_busy;
+extern void *ios_jit_rx_base_global, *ios_jit_rw_base_global;
+extern size_t ios_jit_pool_size_global;
+
+void ideck_wine_jit_pool_forget( void )
+{
+    int i;
+    __atomic_store_n( &ios_pool_gone, 1, __ATOMIC_SEQ_CST );
+    for (i = 0; i < 400 && __atomic_load_n( &ios_pool_warmer_busy, __ATOMIC_SEQ_CST ); i++) usleep( 5000 );
+    ios_jit_rw_base_global = NULL;
+    ios_jit_rx_base_global = NULL;
+    ios_jit_pool_size_global = 0;
+    dprintf( 2, "[pool-warmer] pool forgotten before release (waited %d ms)\n", i * 5 );
+}
